+/***********************************************************************
+ *              macdrv_set_view_tracks_superview
+ *
+ * Let a view grow and shrink with its superview.  Used for the client
+ * surface of a top-level window, so a Metal view follows the window when
+ * Cocoa resizes it (e.g. entering full screen) before Wine catches up.
+ */
+void macdrv_set_view_tracks_superview(macdrv_view v, bool tracks)
+{
+@autoreleasepool
+{
+    NSView* view = (NSView*)v;
+
+    OnMainThreadAsync(^{
+        [view setAutoresizingMask:tracks ? (NSViewWidthSizable | NSViewHeightSizable) : NSViewNotSizable];
+    });
+}
+}
