ntdll: on macOS x86_64, keep GSBASE on the pthread TSD instead of swapping to the TEB.

Upstream (3a16aabbf5, Wine 9.17) swaps GSBASE to the TEB while PE code runs. D3DMetal
calls macOS code (pthread_setname_np in D3DMThreadInit) directly from Windows threads,
where %gs:0 then reads TEB.ExceptionList (NULL) instead of pthread_self, and crashes.
CrossOver/WineForge keep the pre-9.17 layout: GSBASE stays on the TSD and Wine mirrors
TEB.Self (0x30) and ThreadLocalStoragePointer (0x58) into the TSD slots Apple reserves
for Wine (6 and 11). Peb (0x60) is deliberately not mirrored: TSD slot 12 is libc's
localtime buffer, so PE code reads the PEB through %gs:0x30 instead. Ported from
WineForge (Wine 11.19) dlls/ntdll/unix/signal_x86_64.c, signal_x86_64.c and loader.c.

diff --git a/dlls/ntdll/loader.c b/dlls/ntdll/loader.c
index ac42ba7..052dc6e 100644
--- a/dlls/ntdll/loader.c
+++ b/dlls/ntdll/loader.c
@@ -1393,6 +1393,9 @@ static BOOL alloc_tls_slot( LDR_DATA_TABLE_ENTRY *mod )
             if (!new) return FALSE;
             if (old) memcpy( new, old, old_module_count * sizeof(*new) );
             teb->ThreadLocalStoragePointer = new;
+#ifdef __x86_64__  /* macOS-specific hack */
+            if (teb->Instrumentation[0]) ((TEB *)teb->Instrumentation[0])->ThreadLocalStoragePointer = new;
+#endif
             TRACE( "thread %04lx tls block %p -> %p\n", HandleToULong(teb->ClientId.UniqueThread), old, new );
             /* FIXME: can't free old block here, should be freed at thread exit */
         }
@@ -1638,6 +1641,10 @@ static NTSTATUS alloc_thread_tls(void)
         TRACE( "slot %u: %u/%lu bytes at %p\n", i, size, dir->SizeOfZeroFill, pointers[i] );
     }
     NtCurrentTeb()->ThreadLocalStoragePointer = pointers;
+#ifdef __x86_64__  /* macOS-specific hack */
+    if (NtCurrentTeb()->Instrumentation[0])
+        ((TEB *)NtCurrentTeb()->Instrumentation[0])->ThreadLocalStoragePointer = pointers;
+#endif
     return STATUS_SUCCESS;
 }
 
@@ -3972,6 +3979,10 @@ void WINAPI LdrShutdownThread(void)
     if ((pointers = NtCurrentTeb()->ThreadLocalStoragePointer))
     {
         NtCurrentTeb()->ThreadLocalStoragePointer = NULL;
+#ifdef __x86_64__  /* macOS-specific hack */
+        if (NtCurrentTeb()->Instrumentation[0])
+            ((TEB *)NtCurrentTeb()->Instrumentation[0])->ThreadLocalStoragePointer = NULL;
+#endif
         for (i = 0; i < tls_module_count; i++) RtlFreeHeap( GetProcessHeap(), 0, pointers[i] );
         RtlFreeHeap( GetProcessHeap(), 0, pointers );
     }
